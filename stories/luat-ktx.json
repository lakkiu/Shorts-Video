      "beats": [{ "say": "narrator", "text": "Minh thở phào. Cậu đã không mở cửa." }, { "say": "narrator", "text": "Rồi cậu nhìn xuống sàn." }] },
    { "angle": "floor-track", "move": "pan-right",
      "beats": [{ "say": "narrator", "text": "Những dấu chân ướt... đi từ khe cửa... thẳng vào trong phòng.", "also": [{ "sfx": "drips", "at": 0 }] }] },
    { "angle": "reveal", "move": "push",
      "chars": [
        { "id": "minh", "char": "minhPJ", "mark": "room-mid", "mood": "neutral", "keys": [{ "at": "b0+1.0", "mood": "scared", "look": 0.8, "pose": "cower" }] },
