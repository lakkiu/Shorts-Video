      "fx": [{ "type": "flicker", "at": "b1", "rate": 16, "threshold": 0.55, "depth": 0.45 }, { "type": "blackout", "at": "e1+0.1" }],
      "beats": [
        { "say": "narrator", "text": "Và dừng lại... ngay sau lưng cậu.", "gap": 0.5 },
        { "say": "ghost", "text": "Cậu không mở cửa... nhưng tớ vào lâu rồi.", "also": [{ "sfx": "sting", "at": 4.15 }], "gap": 0.6 }
      ] },
    { "black": true, "text": "Bạn có dám nhìn ra sau không?", "hold": 2.6 }
